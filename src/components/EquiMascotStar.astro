---
// The star-eyed green mascot with a yellow burst, from the Figma hero's "AI Form Parameter" window.
// Pieces are Figma px on a 106.851 box, expressed in cqw.
import sBody from "../assets/equiteam/figma/s-body.svg";
import sEyeL from "../assets/equiteam/figma/s-eye-l.svg";
import sEyeR from "../assets/equiteam/figma/s-eye-r.svg";
import sMask from "../assets/equiteam/figma/s-mask.svg";
import sGlasses from "../assets/equiteam/figma/s-glasses.svg";
import sStar from "../assets/equiteam/figma/s-star.svg";
import burst from "../assets/equiteam/figma/burst.svg";

interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;

const BOX = 106.851;
const u = (px: number) => `${((px / BOX) * 100).toFixed(4)}cqw`;
const at = (x: number, y: number, w: number, h: number) =>
  `left:${u(x)};top:${u(y)};width:${u(w)};height:${u(h)}`;
---

<div class={`ms ${cls}`} aria-hidden="true">
  <img class="ms-burst" src={burst.src} alt="" />
  <div class="ms-box">
    <div class="ms-fill" style="inset:0 5.68% 8.62% 7.48%"><img class="ms-img" src={sBody.src} alt="" /></div>
    <img src={sEyeL.src} alt="" style={at(15.57, 37.44, 33.592, 35.512)} />
    <img src={sEyeR.src} alt="" style={at(57.22, 37.86, 33.592, 35.512)} />
    <div class="ms-mouth" style={`${at(44.18, 68.57, 18.652, 15.818)}`}>
      <img src={sMask.src} alt="" style={`left:${u(3.03)};top:${u(3.72)};width:${u(13.651)};height:${u(13.532)}`} />
    </div>
    <img src={sGlasses.src} alt="" style={at(4.21 - 0, 44.17 - 11.36, 95.914, 45.309)} />
    <img src={sStar.src} alt="" style={`left:${u(11.36)};top:${u(36.6 - 0.9)};width:${u(38.281 * 0.9888)};height:${u(34.619)}`} />
    <img src={sStar.src} alt="" style={`left:${u(58.05)};top:${u(35.34 - 0.9)};width:${u(38.281 * 0.9888)};height:${u(34.619)}`} />
  </div>
</div>

<style>
  .ms {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1;
    pointer-events: none;
  }
  .ms img,
  .ms-mouth {
    position: absolute;
    max-width: none;
  }
  .ms img {
    display: block;
  }
  .ms-fill {
    position: absolute;
  }
  .ms .ms-img {
    position: static;
    width: 100%;
    height: 100%;
  }
  .ms-box {
    position: absolute;
    inset: 0;
    transform: rotate(-18.74deg);
  }
  .ms-burst {
    left: 50%;
    top: 50%;
    width: 236.7%;
    height: auto;
    transform: translate(-50%, -50%) rotate(40.66deg);
  }
  .ms-mouth {
    transform: rotate(9.08deg);
  }
</style>
