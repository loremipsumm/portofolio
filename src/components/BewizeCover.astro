---
// Landing-page cover for BEWIZE. There are no shareable screens, so this is an illustration built from the facts
// in cases.ts: one platform, three products, corporate users. No bank logo or real UI.
interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;

const products = [
  { t: "Cash Management", c: "#5eead4" },
  { t: "Value Chain", c: "#fcd34d" },
  { t: "Trade Finance", c: "#a5b4fc" },
];
---

<div class={`bw relative isolate aspect-[4/3] overflow-hidden rounded-[28px] ${cls}`} style="container-type: inline-size">
  <p class="display pointer-events-none absolute inset-x-0 top-[6%] select-none text-center text-[24cqw] text-white/[0.06]" aria-hidden="true">BEWIZE</p>

  <div class="absolute inset-x-[6%] top-[6%] flex items-center justify-between text-[2.4cqw] font-semibold text-white/70">
    <span>Wholesale digital banking</span>
    <span>/2026</span>
  </div>

  <!-- platform hub -->
  <div class="absolute left-1/2 top-[30%] -translate-x-1/2 rounded-[3cqw] bg-white px-[5cqw] py-[3cqw] text-center shadow-[0_3cqw_6cqw_-2cqw_rgb(0_0_0/0.5)]">
    <p class="font-display text-[6cqw] font-extrabold leading-none tracking-tight text-[#0b1f33]">BEWIZE</p>
    <p class="mt-[1cqw] text-[2.2cqw] text-[#5e6270]">One platform for corporate customers</p>
  </div>

  <!-- connectors -->
  <svg class="absolute inset-x-0 top-[52%] h-[16%] w-full" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M200 0 V20 M200 20 H70 V60 M200 20 V60 M200 20 H330 V60" fill="none" stroke="rgb(255 255 255 / 0.35)" stroke-width="2" stroke-dasharray="5 6" vector-effect="non-scaling-stroke" />
  </svg>

  <ul class="absolute inset-x-[5%] top-[68%] grid grid-cols-3 gap-[2cqw]">
    {products.map((p, i) => (
      <li class="rounded-[2.4cqw] bg-white/10 p-[2.4cqw] ring-1 ring-white/15 backdrop-blur" data-float={8 + i * 2}>
        <span class="block h-[1cqw] w-[6cqw] rounded-full" style={`background:${p.c}`}></span>
        <p class="mt-[1.6cqw] text-[2.8cqw] font-semibold leading-tight text-white">{p.t}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .bw {
    background:
      radial-gradient(ellipse 70% 60% at 85% 10%, rgb(45 212 191 / 0.28), transparent 70%),
      radial-gradient(ellipse 60% 60% at 0% 100%, rgb(129 140 248 / 0.25), transparent 70%),
      linear-gradient(160deg, #10304a 0%, #0b1f33 60%, #081624 100%);
  }
</style>
