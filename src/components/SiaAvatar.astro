---
// A flat, Memoji-style avatar drawn in SVG: a soft gradient tile, shoulders, head, hair, a friendly face and
// an optional accessory. These are illustrated stand-ins, not likenesses; swap in real Memoji exports by
// passing `photo` (an imported image) to the card in sia.astro.
interface Props {
  skin?: string;
  hair?: string;
  hairStyle?: "short" | "side" | "curly" | "long" | "bun" | "buzz";
  shirt?: string;
  bg?: [string, string];
  accessory?: "none" | "glasses" | "headset" | "beard";
  label: string;
  class?: string;
}
const {
  skin = "#f2c9a5",
  hair = "#2b2118",
  hairStyle = "short",
  shirt = "#414651",
  bg = ["#e9eaeb", "#d5d7da"],
  accessory = "none",
  label,
  class: cls = "",
} = Astro.props;

const id = `av-${label.toLowerCase().replace(/[^a-z0-9]+/g, "")}`;
const skinShade = "#00000014";
---

<svg viewBox="0 0 160 160" class={cls} role="img" aria-label={`Illustrated avatar of ${label}`}>
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={bg[0]} />
      <stop offset="1" stop-color={bg[1]} />
    </linearGradient>
    <clipPath id={`${id}-clip`}><rect width="160" height="160" rx="36" /></clipPath>
  </defs>
  <g clip-path={`url(#${id}-clip)`}>
    <rect width="160" height="160" fill={`url(#${id}-bg)`} />

    {/* hair behind the head */}
    {hairStyle === "long" && (
      <>
        <path d="M42 74 C36 112 44 132 58 136 L62 84Z" fill={hair} />
        <path d="M118 74 C124 112 116 132 102 136 L98 84Z" fill={hair} />
      </>
    )}
    {hairStyle === "bun" && <circle cx="80" cy="22" r="13" fill={hair} />}

    {/* shoulders and neck */}
    <path d="M18 168 C20 132 50 118 80 118 C110 118 140 132 142 168Z" fill={shirt} />
    <path d="M66 104 H94 V124 C90 130 70 130 66 124Z" fill={skin} />
    <path d="M66 112 H94 V120 C90 126 70 126 66 120Z" fill={skinShade} />

    {/* ears and head */}
    <ellipse cx="45" cy="82" rx="6" ry="9" fill={skin} />
    <ellipse cx="115" cy="82" rx="6" ry="9" fill={skin} />
    <ellipse cx="80" cy="78" rx="35" ry="39" fill={skin} />

    {/* beard */}
    {accessory === "beard" && (
      <path d="M46 84 C46 116 62 122 80 122 C98 122 114 116 114 84 C108 100 98 104 80 104 C62 104 52 100 46 84Z" fill={hair} opacity="0.92" />
    )}

    {/* front hair */}
    {hairStyle === "short" && <path d="M45 74 C42 40 62 26 80 26 C98 26 118 40 115 74 C108 56 96 50 80 50 C64 50 52 56 45 74Z" fill={hair} />}
    {hairStyle === "side" && <path d="M45 76 C40 42 66 22 92 30 C110 35 118 54 115 76 C106 58 92 48 70 52 C58 55 50 64 45 76Z" fill={hair} />}
    {hairStyle === "buzz" && <path d="M47 68 C47 44 64 35 80 35 C96 35 113 44 113 68 C105 55 94 51 80 51 C66 51 55 55 47 68Z" fill={hair} opacity="0.85" />}
    {hairStyle === "bun" && <path d="M45 74 C42 42 62 28 80 28 C98 28 118 42 115 74 C108 56 96 50 80 50 C64 50 52 56 45 74Z" fill={hair} />}
    {hairStyle === "long" && <path d="M44 78 C38 40 62 24 80 24 C98 24 122 40 116 78 C108 56 96 48 80 48 C64 48 52 56 44 78Z" fill={hair} />}
    {hairStyle === "curly" && (
      <g fill={hair}>
        <circle cx="52" cy="58" r="14" /><circle cx="64" cy="44" r="15" /><circle cx="80" cy="40" r="15" />
        <circle cx="96" cy="44" r="15" /><circle cx="108" cy="58" r="14" /><circle cx="46" cy="72" r="9" /><circle cx="114" cy="72" r="9" />
      </g>
    )}

    {/* face */}
    <g fill="#2b2118">
      <ellipse cx="66" cy="82" rx="3.8" ry="4.8" /><ellipse cx="94" cy="82" rx="3.8" ry="4.8" />
    </g>
    <g fill="#fff"><circle cx="67.4" cy="80.2" r="1.3" /><circle cx="95.4" cy="80.2" r="1.3" /></g>
    <g fill="none" stroke="#2b2118" stroke-width="2.2" stroke-linecap="round" opacity="0.8">
      <path d="M59 72 Q66 68 73 71" /><path d="M87 71 Q94 68 101 72" />
    </g>
    <path d="M68 97 Q80 107 92 97" fill="none" stroke="#7a3b2e" stroke-width="2.6" stroke-linecap="round" />
    <g fill="#f08a8a" opacity="0.35"><circle cx="57" cy="93" r="6" /><circle cx="103" cy="93" r="6" /></g>

    {/* accessories */}
    {accessory === "glasses" && (
      <g fill="none" stroke="#252b37" stroke-width="2.6">
        <circle cx="66" cy="82" r="11" /><circle cx="94" cy="82" r="11" /><path d="M77 82 H83" />
      </g>
    )}
    {accessory === "headset" && (
      <g fill="none" stroke="#252b37" stroke-width="4" stroke-linecap="round">
        <path d="M44 80 C42 40 118 40 116 80" />
        <rect x="38" y="76" width="10" height="18" rx="5" fill="#252b37" stroke="none" />
        <rect x="112" y="76" width="10" height="18" rx="5" fill="#252b37" stroke="none" />
        <path d="M118 92 C118 108 104 112 94 110" stroke-width="3" />
      </g>
    )}
  </g>
</svg>
