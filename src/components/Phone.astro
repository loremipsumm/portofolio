---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, class: cls = "", eager = false } = Astro.props;
---

<div class={`rounded-[2.1rem] bg-ink p-[5px] shadow-[0_30px_60px_-20px_rgb(14_15_18/0.45)] ${cls}`}>
  <div class="relative aspect-[290/640] overflow-hidden rounded-[1.8rem] bg-white">
    <Image
      src={src}
      alt={alt}
      widths={[300, 600]}
      sizes="300px"
      class="absolute inset-0 size-full object-cover object-top"
      loading={eager ? "eager" : "lazy"}
    />
  </div>
</div>
