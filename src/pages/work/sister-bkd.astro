---
// Styled after the NEXTSTEP case study on Behance: light grey canvas, black rounded panels, giant lowercase Urbanist
// words, outlined lowercase pill tags, lead text that mixes ink and grey, pastel highlight labels and pinned
// sticky-note cards. Pastels are tinted from SISTER's chart colours. Content comes from the Magang Merdeka
// SISTER BKD Batch VII final report.
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import SectionDock from "../../components/SectionDock.astro";
import { site } from "../../data/site";

import pengabdian from "../../assets/sisterbkd/pengabdian.png";
import pelaporan from "../../assets/sisterbkd/pelaporan.png";
import penelitian1 from "../../assets/sisterbkd/penelitian-1.png";
import kewajiban from "../../assets/sisterbkd/kewajiban.png";
import kesimpulan from "../../assets/sisterbkd/kesimpulan.png";

// Pastel pairs (background, text) tinted from SISTER's teal, orange, blue and red series.
const P = {
  mint: { bg: "#D3F0E4", fg: "#0F6B55" },
  yellow: { bg: "#FCEFB4", fg: "#8A5A00" },
  lilac: { bg: "#E2E3FB", fg: "#3B3FA8" },
  pink: { bg: "#FBDCDD", fg: "#B01D31" },
  sky: { bg: "#D4E8F8", fg: "#1F6B9C" },
};

const sections = [
  { id: "case", t: "Case Study" },
  { id: "planning", t: "Planning" },
  { id: "sprints", t: "Execution" },
  { id: "dashboard", t: "Dashboard" },
  { id: "learnings", t: "Learnings" },
];

const pains = [
  { t: "Hundreds of thousands of reports", d: "BKD collects, analyses and reports workload data from lecturers all over Indonesia." },
  { t: "Data presented ineffectively", d: "The existing views made it hard to see what the numbers were actually saying." },
  { t: "Slow, error-prone analysis", d: "Staff struggled to analyse the data quickly and accurately enough to act on it." },
];

const goals = [
  "Make BKD data easy to visualise and analyse, so ministry staff and lecturers can spot patterns and trends quickly.",
  "Keep the data shown on the dashboard accurate, accessible and transparent for every stakeholder.",
  "Support fast, well-founded decisions for universities and the ministry with integrated data.",
  "Raise the quality of Ditjen Diktiristek's services for managing higher-education staff.",
  "Present BKD data as informative graphs and diagrams.",
  "Add lasting value to SISTER, the integrated resources platform.",
];

const numbers = [
  { n: "7", label: "Sprints", d: "From 6 September to 30 December 2024, each one re-scoped after review.", p: P.sky },
  { n: "25", label: "Epics", d: "The work breakdown, split into charts, tables, filters and interactivity.", p: P.mint },
  { n: "316", label: "Tasks", d: "Every epic broken down until each task could be tracked on its own.", p: P.yellow },
];

// tasks: each role's terms of reference. handoff: what that role needed from design.
const roles = [
  { r: "Product Manager", p: P.lilac, tilt: "-rotate-2", tasks: ["Led the team", "Timeline, WBS and stakeholder talks", "Kept the project on schedule"], handoff: "Design tasks sized to fit a sprint" },
  { r: "UI/UX Designer", p: P.mint, tilt: "rotate-1", me: true, tasks: ["Observation research with stakeholders", "Lo-fi to hi-fi prototypes", "Qualitative design evaluation", "Design system and consistency"], handoff: "The source every other role builds from" },
  { r: "Database Engineer", p: P.sky, tilt: "-rotate-1", tasks: ["Queries for every chart's data", "Tables shaped to the data needs"], handoff: "Which fields and groupings each chart shows" },
  { r: "Fullstack Developer", p: P.yellow, tilt: "rotate-2", tasks: ["Built features from the stories", "Debugged backend and frontend", "Optimised database queries"], handoff: "Components with every state specified" },
  { r: "QA Engineer", p: P.pink, tilt: "-rotate-2", tasks: ["Test scenarios and manual testing", "Bug reports", "User acceptance testing"], handoff: "Screens to check each story against" },
];

const phases = [
  {
    tag: "kick-off",
    t: "Plan with stakeholders, then research per role",
    d: "The team met stakeholders to understand the goal, then the PM built the timeline and WBS. Each division started its own research: database structure, dev environment, and for design, which visual forms suit this data.",
    me: "I mapped the multi-layered BKD data to chart types, so the layout followed the data's shape rather than the other way round.",
    p: P.lilac,
  },
  {
    tag: "sprint 1",
    t: "Learn Agile on a deliberately light sprint",
    d: "Most of the team had never worked in Agile, so sprint 1 focused on learning it: daily stand-ups, a prioritised backlog, iterative tasks. The team still finished more than 70% of the sprint.",
    me: "I validated wireframes with the PM and stakeholders before any hi-fi, so developers never built against an unapproved layout.",
    p: P.mint,
  },
  {
    tag: "sprints 2–7",
    t: "Stable delivery with acceptance criteria and a DoD",
    d: "Every user story got clear acceptance criteria and a specific definition of done. QA could check a story without going back to the developers, and revisions from unclear specs dropped sharply.",
    me: "I turned approved wireframes into hi-fi screens built from one component set, so a chart specified once could be reused on every tab.",
    p: P.sky,
  },
  {
    tag: "every sprint",
    t: "Sprint review and retrospective",
    d: "Stakeholders reviewed finished features directly, so the backlog could follow changing priorities. Retrospectives turned blockers into process fixes.",
    me: "I fed review feedback into the next sprint's designs as backlog items, not as last-minute changes to stories already in build.",
    p: P.yellow,
  },
  {
    tag: "close-out",
    t: "Present, revise, merge to staging",
    d: "The team presented the result to stakeholders, who gave final feedback and handover instructions. After a last revision, the work went through a merge request into staging.",
    me: "I made the final revisions from the stakeholder presentation before the merge into staging.",
    p: P.pink,
  },
];

const ceremonies = ["daily stand-up", "backlog refinement", "acceptance criteria", "definition of done", "sprint review", "retrospective"];

const tabs = [
  { t: "Penelitian Dosen", img: penelitian1, d: "Nine research components behind one row of toggle chips." },
  { t: "Pengabdian Dosen", img: pengabdian, d: "Community-service output: published and unpublished journals, and journal management." },
  { t: "Pelaporan BKD", img: pelaporan, d: "Who has reported their workload and who hasn't, across every distribution." },
  { t: "Kesimpulan LKD BKD", img: kesimpulan, d: "The final verdict on each workload report: met or not met." },
  { t: "Kewajiban Khusus", img: kewajiban, d: "Special obligations in three states: met, not yet met and not met." },
];

const research = [
  "Published research or thinking",
  "Disseminated research or thinking",
  "Ministry / LPNK research, unpublished",
  "Translated or adapted scientific books",
  "Edited scientific works",
  "Technology designs registered with HaKI",
  "Unpublished work applied in industry",
  "Policy briefs and policy papers",
  "Unpatented technology presented at a forum",
];

const distributions = [
  { t: "Lokasi PT", chips: ["Choropleth map", "Search"], p: P.mint },
  { t: "Usia Dosen", chips: ["Baby Boomer", "Gen X", "Millennial", "Gen Z"], p: P.yellow },
  { t: "Jenis PT", chips: ["Akademik", "Vokasi"], p: P.sky },
  { t: "Akreditasi PT", chips: ["Unggul", "Baik Sekali", "Baik", "A", "B", "C"], p: P.pink },
  { t: "Status PT", chips: ["PTN-BH", "PTN-BLU", "PTN-SATKER", "PTN", "PTS · LLDIKTI 1–17", "PT-KL", "PTA"], p: P.lilac },
];

// Each interaction written as a spec: trigger, then what the chart does.
const features = [
  { icon: "cursor", t: "Hover", d: "On hover, any bar, slice or province shows its detail and extra notes in a tooltip. No click, no page change.", p: P.mint },
  { icon: "download", t: "Download", d: "Every chart exports as JPG, PNG or PDF; table data exports as PDF. One menu, same place on every card.", p: P.yellow },
  { icon: "filter", t: "Filter", d: "A year filter scopes the whole dashboard; Status PT adds an institution-type filter of its own.", p: P.sky },
  { icon: "search", t: "Search", d: "The location and status charts take a search, jumping straight to a province or a university.", p: P.pink },
];

// How the design was made buildable. The template and component ideas come from the screens themselves.
const decisions = [
  { t: "One template, 13 tabs", d: "Every tab uses the same frame: year filter, five distribution charts, then the table. Developers build it once and fill it 13 times.", p: P.mint },
  { t: "States are part of the component", d: "Tooltips, active and dimmed pie slices, and per-series callouts were designed as components, so behaviour is specified once, not per screen.", p: P.lilac },
  { t: "Specs QA can test", d: "Each user story carried acceptance criteria and a definition of done, so QA could check a story without going back to the developers.", p: P.yellow },
];

const learnings = [
  { t: "Design in components, not screens", d: "Thirteen tabs only stayed consistent because the parts were shared. A layout fixed once was fixed everywhere." },
  { t: "Acceptance criteria are design work", d: "Clear criteria and a definition of done on every story meant far less work was redone because of an unclear spec." },
  { t: "Learn the team's process early", d: "Nobody had used Agile before. Spending sprint 1 learning it still delivered over 70% of the sprint, and every sprint after was steadier." },
];

const recs = [
  { t: "Top 10 Asesor, with better indicators", d: "Proposed in batch 7 to list each assessor's origin, mentor and number of assessments. Paused: ranking by count ignores whether the assessments led to good performance.", p: P.yellow },
  { t: "A dashboard for each university", d: "Roles per university, such as admins or deans, so each sees its own lecturers' reporting, obligations, community service and research.", p: P.mint },
];

const icons: Record<string, string> = {
  cursor: '<path d="m4 4 7 17 2.5-7.5L21 11 4 4Z"/>',
  download: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/>',
  filter: '<path d="M3 4h18l-7 8.5V19l-4 2v-8.5L3 4Z"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  check: '<path d="m6 12 4 4 8-8"/>',
  alert: '<path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4M12 17h.01"/>',
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
};
---

<Base
  brand={{ accent: "#137A63", accentSoft: "#D3F0E4", pop: "#D3F0E4" }}
  title={`SISTER BKD case study | ${site.name}`}
  description="Case study: designing the SISTER BKD dashboard as a buildable system, one template, shared chart components and testable specs, for Indonesia's higher-education ministry."
>
  <div class="ns">
    <!-- HERO -->
    <section class="px-2 pt-20 sm:px-4 sm:pt-24">
      <div class="relative isolate overflow-hidden rounded-[28px] bg-[linear-gradient(160deg,#d3f0e4_0%,#e6f1fa_55%,#f3f3f5_100%)] px-5 pb-10 pt-6 sm:px-10 sm:pb-14">
        <div class="flex flex-wrap items-start justify-between gap-3 text-sm font-medium">
          <p>//Role: UI/UX Designer · UX engineering</p>
          <p class="flex gap-6"><span>//Type: Government dashboard</span><span>//Year: 2024</span></p>
        </div>

        <div class="mt-14 grid items-end gap-10 lg:mt-20 lg:grid-cols-[1fr_1.15fr]">
          <div>
            <h1 class="ns-giant text-[clamp(5rem,15vw,12.5rem)]" data-intro>
              <span class="block">sister</span>
              <span class="block">bkd<span class="text-[#137a63]">.</span></span>
            </h1>
            <p class="mt-6 max-w-md text-lg leading-snug" data-reveal="0.3">
              A lecturer-workload dashboard for Indonesia's higher-education ministry. I designed it as a system the team could build: one template, shared chart components, specs QA could test.
            </p>
          </div>

          <!-- laptop mockup -->
          <div class="relative" data-reveal="0.3">
            <div class="rounded-t-[18px] bg-[#1c1c1e] p-2 pb-3 shadow-[0_40px_80px_-30px_rgb(0_0_0/0.5)] sm:p-3">
              <Image src={pengabdian} alt="SISTER BKD dashboard, Pengabdian Dosen tab, with an Indonesia map and a hover tooltip" widths={[700, 1200]} sizes="(min-width:1024px) 640px, 92vw" class="aspect-[16/10] w-full rounded-[8px] object-cover object-top" loading="eager" />
            </div>
            <div class="mx-[-4%] h-3 rounded-b-[14px] bg-[linear-gradient(#d4d4d8,#a1a1aa)]"></div>

            <div data-float="8" class="absolute -left-4 top-[18%] hidden items-center gap-3 rounded-2xl bg-white/90 px-4 py-3 shadow-xl backdrop-blur sm:flex">
              <span class="grid size-9 place-items-center rounded-full" style={`background:${P.mint.bg};color:${P.mint.fg}`}>
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons.check} />
              </span>
              <span class="text-sm leading-tight"><b class="font-semibold">Merged to staging</b><br /><span class="text-[#8e8e93]">after 7 sprints</span></span>
            </div>
            <div data-float="10" class="absolute -right-3 bottom-[22%] hidden rounded-2xl bg-white/90 px-4 py-3 shadow-xl backdrop-blur md:block">
              <p class="text-xs text-[#8e8e93]">Shipped</p>
              <p class="text-2xl font-semibold leading-none">13 <span class="text-sm font-medium">tabs</span></p>
            </div>
          </div>
        </div>

        <a href="#case" class="mx-auto mt-10 grid size-14 place-items-center rounded-full bg-[#161616] text-white transition-transform hover:translate-y-1" aria-label="Scroll to the case study">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
        </a>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="case" class="ns-anchor wrap pt-24 sm:pt-32">
      <div class="grid gap-8 rounded-[28px] bg-white p-7 sm:p-12 lg:grid-cols-[1fr_2fr]">
        <p class="font-medium">About the project</p>
        <p class="ns-lead text-[clamp(1.6rem,3vw,2.5rem)]" data-reveal>
          My job was not only to make BKD data readable, but to make the design
          {" "}<span class="g">buildable, repeatable and testable</span>{" "}
          for a database engineer, fullstack developers and QA, sprint after sprint, across 13 tabs.
        </p>
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-[1fr_1.1fr]">
        <!-- visual with floating issue cards -->
        <div class="relative min-h-[26rem] overflow-hidden rounded-[28px] bg-[#e4e4e8]" data-reveal>
          <Image src={kesimpulan} alt="" widths={[600, 1000]} sizes="(min-width:1024px) 600px, 92vw" class="absolute inset-0 size-full object-cover object-top opacity-60 blur-[1.5px]" />
          <div class="relative flex h-full flex-col justify-between gap-6 p-5 sm:p-7">
            {pains.map((p, i) => (
              <div class={`max-w-[17rem] rounded-2xl bg-white/85 p-4 shadow-lg backdrop-blur ${i === 1 ? "self-end" : ""}`}>
                <p class="flex items-center gap-2 font-semibold">
                  <span class="grid size-7 shrink-0 place-items-center rounded-lg" style={`background:${P.pink.bg};color:${P.pink.fg}`}>
                    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.alert} />
                  </span>
                  {p.t}
                </p>
                <p class="mt-1.5 text-sm text-[#6e6e73]">{p.d}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="grid gap-4" data-stagger>
          <div class="grid gap-4 rounded-[24px] bg-white p-6 sm:grid-cols-[7rem_1fr]">
            <span class="ns-tag h-fit">problem</span>
            <div>
              <p class="font-semibold">BKD data was hard to read, and slow to act on.</p>
              <p class="mt-2 text-[#8e8e93]">Kemdiktisaintek manages lecturers' workload across every Indonesian university. The data existed, but the way it was presented made patterns hard to see.</p>
            </div>
          </div>
          <div class="grid gap-4 rounded-[24px] bg-white p-6 sm:grid-cols-[7rem_1fr]">
            <span class="ns-tag h-fit">objective</span>
            <div>
              <p class="font-semibold">Make BKD data easy to visualise, analyse and trust.</p>
              <ol class="mt-3 space-y-1.5 text-sm text-[#8e8e93]">
                {goals.map((g, i) => <li class="flex gap-2"><span class="font-semibold text-[#161616]">{i + 1}.</span>{g}</li>)}
              </ol>
            </div>
          </div>
          <div class="grid gap-4 rounded-[24px] bg-white p-6 sm:grid-cols-[7rem_1fr]">
            <span class="ns-tag h-fit">my approach</span>
            <div>
              <p class="font-semibold">Design the system once, then fill it 13 times.</p>
              <p class="mt-2 text-[#8e8e93]">One page template with the same five data distributions on every tab, chart components with their states built in, and four interactions (hover, download, filter, search) specified once.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- statement card -->
      <div class="relative mt-24 sm:mt-32">
        <div class="rounded-[28px] bg-[#161616] text-white">
          <div class="mx-auto max-w-3xl px-8 py-12 text-center sm:px-14 sm:py-16" data-reveal>
            <span class="block font-serif text-6xl leading-none" aria-hidden="true">“</span>
            <p class="mt-2 text-xl italic leading-snug sm:text-2xl">
              Ditjen Diktiristek decided to build a dashboard into SISTER, so users could
              {" "}<span class="text-[#bdeed8]">see the patterns, trends and important details in BKD data</span>{" "}
              without digging for them.
            </p>
            <p class="mt-8 text-[#8e8e93]">— The initiative</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PLANNING -->
    <section id="planning" class="ns-anchor wrap pt-24 sm:pt-32">
      <h2 class="ns-giant text-[clamp(4.5rem,19vw,16rem)]" data-reveal>planning</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-[2fr_1fr] lg:items-end">
        <div>
          <span class="ns-tag">work plan</span>
          <p class="mt-5 max-w-2xl text-[clamp(1.6rem,3vw,2.4rem)] leading-tight">Design work had to fit the same plan as the build.</p>
        </div>
        <p class="text-[#8e8e93] lg:pb-1">The PM's timeline and work breakdown set the pace. My design tasks sat inside those epics, so every screen had a story and a sprint it belonged to.</p>
      </div>

      <!-- numbers -->
      <ul class="mt-14 grid overflow-hidden rounded-[28px] bg-white sm:grid-cols-3" data-stagger>
        {numbers.map((s, i) => (
          <li class={`flex flex-col p-6 sm:p-8 ${i ? "border-t border-[#ececf0] sm:border-l sm:border-t-0" : ""}`}>
            <p class="text-[clamp(3.5rem,6vw,5rem)] font-medium leading-none tracking-[-0.05em]">{s.n}</p>
            <span class="mt-4 w-fit rounded-md px-2.5 py-1 font-medium" style={`background:${s.p.bg}`}>{s.label}</span>
            <p class="mt-3 text-sm text-[#8e8e93]">{s.d}</p>
          </li>
        ))}
      </ul>

      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <!-- timeline -->
        <div class="flex flex-col rounded-[28px] bg-white p-6 sm:p-8" data-reveal>
          <div class="flex flex-wrap items-center justify-between gap-4">
            <p class="text-xl font-semibold">Project timeline</p>
            <span class="ns-tag">7 sprints</span>
          </div>
          <div class="mt-8 flex flex-1 flex-col overflow-x-auto">
            <div class="flex min-w-[30rem] flex-1 flex-col">
              <ol class="grid min-h-28 flex-1 grid-cols-7 gap-2">
                {Array.from({ length: 7 }).map((_, i) => (
                  <li class="flex items-end justify-center rounded-2xl px-2 py-4 font-semibold tabular-nums" style={`background:${i === 0 ? P.mint.bg : i === 6 ? P.pink.bg : P.sky.bg};color:${i === 0 ? P.mint.fg : i === 6 ? P.pink.fg : P.sky.fg}`}>
                    S{i + 1}
                  </li>
                ))}
              </ol>
              <div class="mt-3 grid grid-cols-7 gap-2 text-sm">
                <p class="border-t-2 pt-2" style={`border-color:${P.mint.fg}`}>Agile onboarding</p>
                <p class="col-span-5 border-t-2 pt-2" style={`border-color:${P.sky.fg}`}>Iterative delivery</p>
                <p class="border-t-2 pt-2" style={`border-color:${P.pink.fg}`}>Review, staging</p>
              </div>
              <div class="flex justify-between pt-6 text-sm text-[#8e8e93]">
                <span>6 Sep 2024 · kick-off</span>
                <span>30 Dec 2024 · close-out</span>
              </div>
            </div>
          </div>
        </div>

        <!-- work breakdown: project → epics → tasks -->
        <div class="flex flex-col rounded-[28px] bg-white p-6 sm:p-8" data-reveal="0.1">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <p class="text-xl font-semibold">Work breakdown</p>
            <span class="ns-tag">WBS</span>
          </div>
          <ol class="mt-8 ml-2 flex-1 space-y-6 border-l-2 border-dashed border-[#d4d4d8] pl-6">
            <li class="relative">
              <span class="absolute -left-[1.95rem] top-1 size-3 rounded-full bg-[#161616]" aria-hidden="true"></span>
              <p class="text-sm text-[#8e8e93]">Dashboard features · <b class="font-semibold text-[#161616]">{tabs.length}</b></p>
              <ul class="mt-2 flex flex-wrap gap-1.5">
                {tabs.map((t) => <li class="rounded-full bg-[#161616] px-3 py-1.5 text-sm text-white">{t.t}</li>)}
              </ul>
            </li>
            <li class="relative">
              <span class="absolute -left-[1.95rem] top-1 size-3 rounded-full" style={`background:${P.mint.fg}`} aria-hidden="true"></span>
              <p class="text-sm text-[#8e8e93]">Epics · <b class="font-semibold text-[#161616]">25</b></p>
              <ul class="mt-2 grid grid-cols-[repeat(25,minmax(0,1fr))] gap-1" aria-label="25 epics" data-wbs-epics>
                {Array.from({ length: 25 }).map(() => <li class="aspect-square rounded-[3px]" style={`background:${P.mint.bg};box-shadow:inset 0 0 0 1px ${P.mint.fg}33`}></li>)}
              </ul>
            </li>
            <li class="relative">
              <span class="absolute -left-[1.95rem] top-1 size-3 rounded-full" style={`background:${P.sky.fg}`} aria-hidden="true"></span>
              <p class="text-sm text-[#8e8e93]">Tasks · <b class="font-semibold text-[#161616]">316</b></p>
              <ul class="mt-2 flex flex-wrap gap-1" aria-label="316 tasks" data-wbs-tasks>
                {Array.from({ length: 316 }).map(() => <li class="size-1.5 rounded-full" style={`background:${P.sky.fg}99`}></li>)}
              </ul>
            </li>
          </ol>
          <p class="mt-6 flex flex-wrap items-center gap-2 text-sm text-[#8e8e93]">
            Epics cover:
            {["charts", "tables", "filters", "interactivity"].map((t) => <span class="ns-tag text-[#161616]">{t}</span>)}
          </p>
        </div>
      </div>
    </section>

    <!-- TEAM (dark) -->
    <section class="mx-2 mt-24 rounded-[28px] bg-[#161616] py-20 text-white sm:mx-4 sm:mt-32 sm:py-28">
      <div class="wrap">
        <h2 class="ns-giant text-[clamp(4.5rem,19vw,16rem)] text-[#bdeed8]" data-reveal>team</h2>
        <div class="mt-6 grid gap-8 lg:grid-cols-[2fr_1fr] lg:items-start">
          <p class="ns-lead text-[clamp(1.4rem,2.6vw,2.1rem)]" data-reveal="0.1">
            {" "}<span class="g">Every role built from what design handed over,</span>{" "}
