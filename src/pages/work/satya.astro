<style>
  /* Hero wall: each column loops its doubled content upward (middle one downward). */
  .satya-col {
    animation: satya-drift var(--dur) linear infinite;
  }
  .satya-col--rev {
    animation-direction: reverse;
  }
  @keyframes satya-drift {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  /* Features: native horizontal scroll by default... */
  .satya-h__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .satya-h {
    padding-block: 6rem;
  }
  /* ...pinned and scroll-driven on large screens. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .satya-h {
      height: calc(var(--n) * 70vh);
      padding-block: 0;
    }
    .satya-h__pin {
      position: sticky;
      top: 0;
      display: flex;
      height: 100svh;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }
    .satya-h__viewport {
      overflow: visible;
    }
    .satya-h__track {
      will-change: transform;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .satya-col {
      animation: none;
    }
  }
</style>

<script>
  import { scroll } from "motion";

  const mq = window.matchMedia("(min-width: 1024px) and (prefers-reduced-motion: no-preference)");
  let stop: (() => void) | undefined;

  // Runs on first load and again after each client-side navigation.
  function setup() {
    stop?.();
    stop = undefined;
    const section = document.querySelector<HTMLElement>("[data-hscroll]");
    const track = section?.querySelector<HTMLElement>("[data-track]");
    const bar = section?.querySelector<HTMLElement>("[data-bar]");
    if (!section || !track) return;
    track.style.transform = "";
    if (!mq.matches) return;
    stop = scroll(
      (progress: number) => {
        const distance = Math.max(0, track.scrollWidth - window.innerWidth);
        track.style.transform = `translate3d(${-progress * distance}px,0,0)`;
        if (bar) bar.style.transform = `scaleX(${progress})`;
      },
      { target: section, offset: ["start start", "end end"] },
    );
  }

  mq.addEventListener("change", setup);
  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", () => {
    stop?.();
    stop = undefined;
  });
  setup();
</script>
